      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:var(--s-2,.5rem)}.ds-chip{display:inline-flex;align-items:center;min-height:44px;padding:.375rem .75rem;font:400 .9375rem/1.55 Onest,system-ui,sans-serif;color:var(--fg,#141a2a);background:var(--surface,#fefefe);border:1px solid var(--line,#dcded9);border-radius:var(--r-control,8px);cursor:pointer;transition:transform var(--dur,.18s) var(--ease,cubic-bezier(.16,1,.3,1))}.ds-chip[aria-pressed=true]{color:var(--accent-text,#2544bd);background:var(--accent-soft,#e5ebfc);border-color:var(--accent,#2449d8);font-weight:700}.ds-chip[aria-pressed=false]:hover{background:var(--line,#dcded9)}.ds-chip:active{transform:scale(.97)}.ds-chip:focus-visible{outline:3px solid var(--accent,#2449d8);outline-offset:2px}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:.01ms;animation-duration:.01ms}}"
    },
    {
      "name": "Карточка работы",
      "kind": "card",
      "refersTo": "work-card",
      "description": "Поверхность коллекции с раскрытием подробностей.",
      "html": "<details class=\"ds-work\"><summary class=\"ds-work-summary\"><span><span class=\"ds-work-title\">Моё исследование</span><small class=\"ds-work-meta\">1 из 4 шагов</small></span></summary><p class=\"ds-work-content\">Личный вклад, результат и следующий шаг.</p></details>",
      "css": ".ds-work{min-width:0;color:var(--fg,#141a2a);background:var(--surface,#fefefe);border:0;border-radius:12px}.ds-work-summary{padding:32px;min-height:220px;display:flex;align-items:flex-end;list-style:none;cursor:pointer;border-radius:12px}.ds-work-summary::-webkit-details-marker{display:none}.ds-work-title{display:block;margin-bottom:18px;font:600 clamp(26px,3vw,38px)/1.2 var(--serif,Literata,Georgia,serif);letter-spacing:-.025em}.ds-work-meta{display:block;margin:.5rem 0;font:400 .875rem/1.6 Onest,system-ui,sans-serif;color:var(--muted,#566177)}.ds-work:not([open]) .ds-work-summary:hover{background:var(--accent-soft,#e5ebfc)}.ds-work-summary:focus-visible{outline:3px solid var(--accent,#2449d8);outline-offset:-3px}.ds-work[open]{padding:0 32px 32px}.ds-work[open]>.ds-work-summary{min-height:0;padding:32px 0;border-radius:0;border-bottom:1px solid var(--line,#dcded9)}.ds-work-content{font:400 1rem/1.55 Onest,system-ui,sans-serif}@media(max-width:639px){.ds-work-summary{padding:24px;min-height:180px}.ds-work[open]{padding:0 20px 20px}}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:.01ms;animation-duration:.01ms}}"
    },
    {
      "name": "Разделы пути",
      "kind": "nav",
      "refersTo": "path-current",
      "description": "Второй уровень с акцентной нижней линией вместо заливки.",
      "html": "<nav class=\"ds-path\" aria-label=\"Разделы моего пути\"><a href=\"#route\" aria-current=\"page\">Работы</a><a href=\"#route/preparation\">Подготовка</a><a href=\"#route/applications\">Заявки</a><a href=\"#route/files\">Файл и данные</a></nav>",
      "css": ".ds-path{display:flex;gap:28px;overflow-x:auto;padding:0 0 4px;border-bottom:1px solid var(--line,#dcded9)}.ds-path a{flex:none;min-height:48px;display:flex;align-items:center;font:600 1rem/1.55 Onest,system-ui,sans-serif;color:var(--muted,#566177);text-decoration:none;border-bottom:2px solid transparent}.ds-path a[aria-current]{color:var(--accent-text,#2544bd);border-bottom-color:var(--accent,#2449d8)}.ds-path a:hover{color:var(--accent-text,#2544bd)}.ds-path a:focus-visible{outline:3px solid var(--accent,#2449d8);outline-offset:2px}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:.01ms;animation-duration:.01ms}}"
    }
  ],
  "narrative": {
    "northStar": "Редакционное рабочее пространство",
    "overview": "Система строится на выразительных заголовках, спокойном фоне и понятной иерархии действий. Literata придаёт работам собственный вес, Onest удерживает формы, условия и навигацию в практичном регистре. Кобальт выделяет выбранный раздел и основное действие.\n\nЭто запись построенного интерфейса, а не утверждение об одобрении итогового макета. Значения ниже описывают основное приложение с тремя вкладками; справочные страницы сохраняют часть прежних базовых правил. Тёмная тема меняет цветовые роли, а стартовая синяя панель сохраняет фиксированную окраску.",
    "keyCharacteristics": [
      "Контраст редакционного заголовка и спокойного интерфейсного текста.",
      "Просторные поверхности работ и компактные строки требований.",
      "Активное состояние выражено цветом; раскрытие добавляет подробности по месту.",
      "Локальные шрифты, светлая и тёмная темы, видимый клавиатурный фокус."
    ],
    "rules": [
      {
        "name": "The Role Color Rule",
        "body": "Используй цвет по роли: основной акцент для действия и выбора, вторичный текст для пояснения, линии для структуры.",
        "section": "colors"
      },
      {
        "name": "The Two Registers Rule",
        "body": "Literata обозначает заголовки и работы, Onest — управление, формы, условия и названия программ в каталоге.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Разделяй рабочие области фоном, отступом и линией; сохраняй карточки работ и строки каталога без падающей тени.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** сохранять распределение ролей Literata и Onest.",
      "**Do** брать цвета из семантических переменных и проверять обе темы.",
      "**Do** отделять рабочие поверхности фоном, отступами и тонкими линиями.",
      "**Do** сохранять видимый фокус и поведение при уменьшении движения."
    ],
    "donts": [
      "**Don't** заменять локальные семейства системным шрифтом в роли основного заголовка.",
      "**Don't** добавлять падающие тени коллекции работ и строкам каталога.",
      "**Don't** выдавать цвета статусов данных за новые фирменные акценты."
    ]
  }
